  "adaptations": {
    "run_bounded.py": "Invoke Docker directly instead of rtk proxy; retry transient PostgreSQL restart connection failures at most four times one second apart; preserve resource and workload thresholds and fail on persistent or other errors; retain full container logs and account for their bytes, failing on log capture errors; reconnect full log capture after intentional container restarts; retry only du ENOENT on disappearing PostgreSQL base relation files (temporary or numeric relfilenodes) at most four times 200ms apart, failing on other/persistent errors; continue PGDATA and cgroup sampling during recognized SQL connection restart gaps, retain prior SQL counters and record each gap, failing after 60 seconds of SQL metric unavailability; record confirmed stopped-container cgroup samples separately while retaining previous resource peaks, matching SQL/disk exit handling; running-container memory failures remain fatal; retry the exact Docker stopped-container transition and disappearing pg_internal.init during sampling (bounded, with persistent failures retained)",
    "test_supervisor.py": "Match direct Docker command positions; cover transient and persistent restart gaps plus non-restart errors; assert full container logs are retained; check live-stream reuse, replay after restart and log capture failure; verify transient/persistent temporary file races and other disk errors; fault-inject SQL restart gaps to verify disk/memory sampling continues and a persistent 60-second gap fails closed; inject stopped and running container memory failures after a healthy sample, checking peak retention and fail-closed live-container behavior; regress those two exact sampling races and persistent/other error behavior",
    "tests/integrations/pg-mdm/time/audit-r53-repair.py": "Retain original bootstrap bytes and hashes; adapt only two helper-audit resolver strategy assertions for #1171 exact deltas; verify reconstructed React exact-version admission and rejection with scheduler enabled; retry only the exact OCI procReady-not-received docker-exec launch failure up to two times, with visible retry evidence; started SQL errors and unrelated Docker/runtime failures remain fatal",
    "tests/integrations/pg-mdm/time/bootstrap_compat.py": "Fail-closed, narrowly matched bootstrap adapter; original helper audit checks remain",
    "test_exec_launch_retry.py": "Regress one successful retry, exhaustion, SQL errors, Docker-daemon failures, unexpected OCI errors, non-docker-exec commands and timeouts without running Docker"
  },
