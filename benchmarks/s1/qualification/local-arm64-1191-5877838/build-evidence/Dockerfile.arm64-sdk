FROM postgres:18.4-bookworm@sha256:efef99e1558f86089bc84bece29208c0777a185ff717ec7fa288a652ce2d0adf
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates build-essential pkg-config libreadline-dev zlib1g-dev \
    libssl-dev clang libclang-dev postgresql-server-dev-18 git \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.98.0 --profile minimal
RUN --mount=type=cache,id=s1-arm64-registry,sharing=locked,target=/usr/local/cargo/registry \
    cargo install --locked cargo-pgrx --version 0.18.0 \
    && cargo pgrx init --pg18 /usr/bin/pg_config
RUN (uname -a; rustc -Vv; cargo pgrx --version; pg_config; dpkg-query -W) > /sdk-manifest.txt
